{
    "name": "innoboxrr/omni-billing-stripe",
    "description": "El adaptador de Stripe para OmniBilling proporciona una integración sin fisuras con la pasarela de pago de Stripe, permitiendo a los desarrolladores ejecutar transacciones de pago, gestionar suscripciones y manejar clientes con facilidad, todo ello a través de la interfaz estandarizada de OmniBilling.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\OmniBillingStripe\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^7.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\OmniBillingStripe\\Providers\\AppServiceProvider"
            ]
        },
        "omni-billing": {
            "stripe": "Innoboxrr\\OmniBillingStripe\\Adapter\\StripeAdapter"
        }
    },
    "require": {
        "stripe/stripe-php": "^13.14",
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "innoboxrr/omni-billing": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\OmniBillingStripe\\Tests\\": "tests/"
        }
    }
}
